# Database Connection (Neon PostgreSQL)
# Replace with your actual Neon connection string in .env.local
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Payload CMS Secret (used for signing session tokens and encryption)
# Generate a secure 32+ character random string in .env.local
PAYLOAD_SECRET="your-payload-secret-at-least-32-characters-long"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend Email Delivery
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="SaZeJe Football <onboarding@resend.dev>"
CONTACT_EMAIL="[EMAIL_ADDRESS]"

# Google Cloud Translation API
GOOGLE_TRANSLATE_API_KEY="your-google-cloud-translation-api-key"

# Cloudflare Turnstile (CAPTCHA)
# For testing: site key "1x00000000000000000000AA", secret key "1x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

